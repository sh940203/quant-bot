# FinMind token（免費註冊 https://finmindtrade.com 取得，可把上限提高到 600/hr；留空為匿名 300/hr）
FINMIND_TOKEN=

# LINE Messaging API（推播用；本機測試可不填，搭配 --no-line）
LINE_CHANNEL_ACCESS_TOKEN=
# 推播對象（你自己的 userId，U 開頭 33 碼；LINE Developers → Basic settings → Your user ID）
LINE_USER_ID=

# 以下只在 GitHub Actions 用（上傳訊號 JSON 到 Cloudflare R2），本機不需要
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PATH_PREFIX=        # 不易猜的隨機字串，例如 openssl rand -hex 16 的輸出

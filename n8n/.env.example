# 加密 n8n 內儲存的 credentials（LINE token、Gemini key 等）。產生後不要再改，否則舊 credentials 會解不開。
# 產生：openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# 對外網址（tunnel 網址，結尾不加 /）。不填也能收 webhook，只是 n8n 介面上顯示的網址會是 localhost。
WEBHOOK_URL=

# quant-bot 訊號 JSON 的公開網址（R2 公開網域 + R2_PATH_PREFIX，結尾不加 /）
SIGNALS_BASE_URL=

# 錯誤通知的收件人（你自己的 LINE userId，U 開頭 33 碼）
LINE_ADMIN_USER_ID=

      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 把錯誤資訊整理成一則 LINE 訊息\nconst ex = $json.execution ?? {};\nconst lines = [\n  '⚠️ 小精靈出錯了',\n  `節點：${ex.lastNodeExecuted ?? '未知'}`,\n  `錯誤：${String(ex.error?.message ?? '未知').slice(0, 300)}`,\n  `執行：#${ex.id ?? '?'}（${$now.setZone('Asia/Taipei').toFormat('MM/dd HH:mm')}）`,\n];\nreturn [{ json: { text: lines.join('\\n') } }];"
      }
    },
    {
      "id": "a8e0a38b-9ed0-4154-8cb7-2ff5063296a2",
      "name": "Push 給管理員",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/push",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $env.LINE_ADMIN_USER_ID, messages: [{ type: 'text', text: $json.text }] }) }}",

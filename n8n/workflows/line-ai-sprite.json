      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 取出 LINE 事件中需要的欄位，交給 AI Agent\nconst e = $input.item.json;\nreturn {\n  json: {\n    chatInput: e.message.text,\n    sessionId: e.source.userId,      // 每位使用者各自的對話記憶\n    replyToken: e.replyToken,\n  },\n};"
      }
    },
    {

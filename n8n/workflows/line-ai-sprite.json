    {
      "id": "03a75a72-2c05-4b6b-8e45-013fc104da6c",
      "name": "整理回覆",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// LINE 不支援 Markdown：去掉 **、#、` 等符號；限制長度；固定附上免責聲明與快速按鈕\nconst QUICK_REPLY = { items: [\n  { type: 'action', action: { type: 'message', label: '📈 今日訊號', text: '今天訊號？' } },\n  { type: 'action', action: { type: 'message', label: '🔄 這週變化', text: '這週訊號有什麼變化？' } },\n  { type: 'action', action: { type: 'message', label: '💎 潛力股', text: '低價潛力股有哪些？' } },\n  { type: 'action', action: { type: 'message', label: '📖 規則說明', text: 'breakout 和潛力股的規則是什麼？' } },\n] };\nlet text = String($json.output ?? '').trim();\ntext = text\n  .replace(/\\*\\*(.+?)\\*\\*/g, '$1')\n  .replace(/^#+\\s*/gm, '')\n  .replace(/`/g, '')\n  .replace(/^\\s*[-*]\\s+/gm, '・');\nif (!text) text = '小精靈這次想不出答案，請換個問法再試一次 🙏';\nif (text.length > 4500) text = text.slice(0, 4500) + '…（內容過長已截斷）';\nreturn {\n  json: {\n    replyToken: $('整理輸入').item.json.replyToken,\n    text: text + '\\n\\n※ 小精靈只解釋 quant-bot 的規則型訊號，僅供參考，非投資建議。',\n    quickReply: QUICK_REPLY,\n  },\n};"
      }
    },
    {
      "id": "3fee7afb-9dd5-496a-a358-f58488fb5ff8",
      "name": "降級回覆",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        100
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// AI Agent 失敗（模型逾時、額度用完、工具錯誤）時的降級回覆\nconst QUICK_REPLY = { items: [\n  { type: 'action', action: { type: 'message', label: '📈 今日訊號', text: '今天訊號？' } },\n  { type: 'action', action: { type: 'message', label: '🔄 這週變化', text: '這週訊號有什麼變化？' } },\n  { type: 'action', action: { type: 'message', label: '💎 潛力股', text: '低價潛力股有哪些？' } },\n  { type: 'action', action: { type: 'message', label: '📖 規則說明', text: 'breakout 和潛力股的規則是什麼？' } },\n] };\nreturn {\n  json: {\n    replyToken: $('整理輸入').item.json.replyToken,\n    text: '小精靈暫時無法回答（AI 服務忙碌或資料讀取失敗），請稍後再試 🙏',\n    quickReply: QUICK_REPLY,\n  },\n};"
      }
    },
    {
      "id": "ac38d5b5-5cce-405f-b30e-edd630832795",
      "name": "LINE Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2480,
        -20
      ],
      "parameters": {

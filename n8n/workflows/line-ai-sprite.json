    {
      "id": "d46e0fe1-8bde-430b-8ff7-ed6fcdefb98f",
      "name": "get_signal_summary",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1220,
        260
      ],
      "parameters": {
        "toolDescription": "取得 quant-bot 今日訊號總覽 JSON。包含：as_of 資料日期、warnings、universe（追蹤清單代號與名稱，用來把股票名稱轉成代號）、breakout（策略規則、buy/sell/hold/flat 代號清單、recent_changes 近10日進出場事件）、discover（評分規則、ranked 今日排名、ranked_history 近10日每日入選名單）。回答「今天訊號」「哪些續抱」「潛力股有哪些」「這週有什麼變化」或需要把股票名稱轉代號時使用。不需要參數。",
        "url": "={{ $env.SIGNALS_BASE_URL }}/latest/summary.json",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "021a3fff-728f-4655-a07e-879d757dd40a",
      "name": "get_ticker_detail",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1360,
        260
      ],
      "parameters": {
        "toolDescription": "取得單一股票的訊號明細 JSON。包含 price（收盤、252 日高低、20MA）、chips（三大法人近 1/5/20 日買賣超，單位張）、breakout（action、entry_level、exit_level、since 進場日、holding_days、pct_above_exit_level、history 近10日部位）、discover（eligible、score、excluded_reason、breakdown 各項得分與原始數值、history 近10日分數）。回答「為什麼續抱 X」「X 為什麼幾分」「X 位階多少」「X 最近變化」時使用。參數 code 是 4 位數台股代號。",
        "url": "={{ $env.SIGNALS_BASE_URL }}/latest/tickers/{{ $fromAI('code', '4 位數台股代號，例如 2330', 'string') }}.json",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "5ac94cf3-c3f7-4eb5-b1e7-1a25a05026e2",
      "name": "get_realtime_quote",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        1500,
        260
      ],
      "parameters": {
        "toolDescription": "查詢台股即時報價（證交所 MIS，上市與上櫃都可查）。回傳 msgArray，其中有資料的那筆欄位：z 成交價、y 昨收、o 開、h 高、l 低、v 累積成交量（張）、n 名稱、d 日期、t 時間。回答「現在價格」「今天漲跌」時使用。參數 code 是 4 位數台股代號。",
        "url": "=https://mis.twse.com.tw/stock/api/getStockInfo.jsp?json=1&delay=0&ex_ch=tse_{{ $fromAI('code', '4 位數台股代號，例如 2330', 'string') }}.tw%7Cotc_{{ $fromAI('code', '4 位數台股代號，例如 2330', 'string') }}.tw",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "6b16fcf6-116f-4483-bbda-8f6a421a7c5a",
      "name": "整理回覆",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        -60
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// LINE 不支援 Markdown：去掉 **、#、` 等符號；限制長度；固定附上免責聲明\nlet text = String($json.output ?? '').trim();\ntext = text\n  .replace(/\\*\\*(.+?)\\*\\*/g, '$1')\n  .replace(/^#+\\s*/gm, '')\n  .replace(/`/g, '')\n  .replace(/^\\s*[-*]\\s+/gm, '・');\nif (!text) text = '小精靈這次想不出答案，請換個問法再試一次 🙏';\nif (text.length > 4500) text = text.slice(0, 4500) + '…（內容過長已截斷）';\nreturn {\n  json: {\n    replyToken: $('整理輸入').item.json.replyToken,\n    text: text + '\\n\\n※ 小精靈只解釋 quant-bot 的規則型訊號，僅供參考，非投資建議。',\n  },\n};"
      }
    },
    {
      "id": "d854a84b-e390-402e-bc1d-fb272d62ec77",
      "name": "降級回覆",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        120
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// AI Agent 失敗（模型逾時、額度用完、工具錯誤）時的降級回覆\nreturn {\n  json: {\n    replyToken: $('整理輸入').item.json.replyToken,\n    text: '小精靈暫時無法回答（AI 服務忙碌或資料讀取失敗），請稍後再試 🙏',\n  },\n};"
      }
    },

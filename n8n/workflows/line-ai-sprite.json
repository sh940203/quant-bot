    {
      "id": "a6ea0edb-969a-451b-84b4-efab89dbda1f",
      "name": "get_signal_summary",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ],
      "parameters": {
        "toolDescription": "取得 quant-bot 今日訊號總覽 JSON。包含：as_of 資料日期、warnings、universe（追蹤清單代號與名稱，用來把股票名稱轉成代號）、breakout（策略規則、buy/sell/hold/flat 代號清單、recent_changes 近10日進出場事件）、discover（評分規則、ranked 今日排名、ranked_history 近10日每日入選名單）。回答「今天訊號」「哪些續抱」「潛力股有哪些」「這週有什麼變化」或需要把股票名稱轉代號時使用。不需要參數。",
        "url": "={{ $env.SIGNALS_BASE_URL }}/latest/summary.json",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "f35e0cc5-bd07-4a7f-a8ac-b78219f2787c",
      "name": "get_ticker_detail",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "toolDescription": "取得單一股票的訊號明細 JSON。包含 price（收盤、252 日高低、20MA）、chips（三大法人近 1/5/20 日買賣超，單位張）、breakout（action、since 進場日、entry_close 進場當天收盤、return_since_entry、holding_days、exit_level 出場線、pct_above_exit_level、entry_level 近20日最高收盤（再進場門檻，不是進場價）、history 近10日部位）、discover（eligible、score、excluded_reason、breakdown 各項得分與原始數值、history 近10日分數）。回答「為什麼續抱 X」「X 為什麼幾分」「X 位階多少」「X 最近變化」時使用。參數 code 是 4 位數台股代號。",
        "url": "={{ $env.SIGNALS_BASE_URL }}/latest/tickers/{{ $fromAI('code', '4 位數台股代號，例如 2330', 'string') }}.json",
        "options": {
